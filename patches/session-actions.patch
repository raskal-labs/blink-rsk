+// Adapted from blinksh/blink 7a427f3 BlinkIntents.swift. Foreground terminal
+// execution intentionally replaces the Fleet/headless runner and output capture.
+import AppIntents
+import BlinkConfig
+import Foundation
+import UIKit
+
+enum SessionActionError: Error, LocalizedError {
+  case unknownHost, sessionNotFound, busy, cancelled, appNotReady
+  var errorDescription: String? {
+    switch self {
+    case .unknownHost: return "Save this host in Blink before using the action."
+    case .sessionNotFound: return "No session with that name is open in this window."
+    case .busy: return "Dismiss the current Blink dialog and try again."
+    case .cancelled: return "Cancelled. No connection or command was started."
+    case .appNotReady: return "Blink is not ready. Open its terminal and try again."
+    }
+  }
+}
+
+@available(iOS 16.0, *)
+struct BlinkHostEntity: AppEntity {
+  static var typeDisplayRepresentation = TypeDisplayRepresentation(name: "Blink Host")
+  static var defaultQuery = BlinkHostQuery()
+  let id: String
+  var displayRepresentation: DisplayRepresentation { DisplayRepresentation(title: "\(id)") }
+  static func all() -> [BlinkHostEntity] {
+    (BKHosts.allHosts() ?? []).compactMap { host -> BlinkHostEntity? in
+      guard let name = host.host, (try? SessionLink.validateHost(name)) != nil else { return nil }
+      return BlinkHostEntity(id: name)
+    }.sorted { $0.id.localizedCaseInsensitiveCompare($1.id) == .orderedAscending }
+  }
+}
+
+@available(iOS 16.0, *)
+struct BlinkHostQuery: EntityStringQuery {
+  func entities(for identifiers: [String]) async throws -> [BlinkHostEntity] {
+    BlinkHostEntity.all().filter { identifiers.contains($0.id) }
+  }
+  func entities(matching string: String) async throws -> [BlinkHostEntity] {
+    BlinkHostEntity.all().filter { $0.id.localizedCaseInsensitiveContains(string) }
+  }
+  func suggestedEntities() async throws -> [BlinkHostEntity] { BlinkHostEntity.all() }
+}
+
+@available(iOS 16.0, *)
+enum SessionInterpreter: String, AppEnum {
+  case sh, bash, python3
+  static var typeDisplayRepresentation = TypeDisplayRepresentation(name: "Remote Interpreter")
+  static var caseDisplayRepresentations: [SessionInterpreter: DisplayRepresentation] = [
+    .sh: "sh", .bash: "bash", .python3: "python3"
+  ]
+}
+
+@available(iOS 16.0, *)
+enum SessionActionRunner {
+  @MainActor
+  static func open(_ link: SessionLink) async throws {
+    for _ in 0..<40 {
+      if let scene = UIApplication.shared.connectedScenes.activeAppScene(),
+         scene.activationState == .foregroundActive,
+         let delegate = scene.delegate as? SceneDelegate,
+         delegate.spaceController.viewIfLoaded?.window != nil {
+        try await delegate.spaceController.openSessionLink(link)
+        return
+      }
+      try await Task.sleep(nanoseconds: 100_000_000)
+    }
+    throw SessionActionError.appNotReady
+  }
+}
+
+@available(iOS 16.0, *)
+struct OpenTerminalSessionIntent: AppIntent {
+  static var title: LocalizedStringResource = "Open Terminal Session"
+  static var description = IntentDescription("Open a terminal or connect to a saved host after confirmation. A session name reuses that open session in the current window; a name alone focuses it. Names last until Blink closes.")
+  static var openAppWhenRun: Bool = true
+  @Parameter(title: "Host") var host: BlinkHostEntity?
+  @Parameter(title: "Session Name") var sessionName: String?
+  static var parameterSummary: some ParameterSummary {
+    Summary("Open a terminal in Blink") { \.$host; \.$sessionName }
+  }
+  @MainActor
+  func perform() async throws -> some IntentResult {
+    try await SessionActionRunner.open(SessionLink.navigation(host: host?.id, id: sessionName))
+    return .result()
+  }
+}
+
+@available(iOS 16.0, *)
+struct RunCommandOnHostIntent: AppIntent {
+  static var title: LocalizedStringResource = "Run Command on Host"
+  static var description = IntentDescription("Confirm a command on a saved host, then start it in a new foreground SSH terminal. Output stays in the terminal; action completion means the session was opened, not that the remote command succeeded. No background execution or returned output.")
+  static var openAppWhenRun: Bool = true
+  @Parameter(title: "Host") var host: BlinkHostEntity
+  @Parameter(title: "Command") var command: String
+  static var parameterSummary: some ParameterSummary { Summary("Run \(\.$command) on \(\.$host)") }
+  @MainActor
+  func perform() async throws -> some IntentResult {
+    try await SessionActionRunner.open(SessionLink.execution(host: host.id, command: command))
+    return .result()
+  }
+}
+
+@available(iOS 16.0, *)
+struct RunScriptOnHostIntent: AppIntent {
+  static var title: LocalizedStringResource = "Run Script on Host"
+  static var description = IntentDescription("Confirm a script, then start it in a new foreground SSH terminal. The host needs base64 --decode and the chosen interpreter. Output and exit status stay in the terminal; the action returns when the session opens. No background execution or returned output.")
+  static var openAppWhenRun: Bool = true
+  @Parameter(title: "Host") var host: BlinkHostEntity
+  @Parameter(title: "Interpreter", default: .sh) var interpreter: SessionInterpreter
+  @Parameter(title: "Script", inputOptions: String.IntentInputOptions(multiline: true)) var script: String
+  static var parameterSummary: some ParameterSummary {
+    Summary("Run a \(\.$interpreter) script on \(\.$host)") { \.$script }
+  }
+  @MainActor
+  func perform() async throws -> some IntentResult {
+    try await SessionActionRunner.open(SessionLink.execution(host: host.id, command: script, interpreter: interpreter.rawValue))
+    return .result()
+  }
+}
+
+@available(iOS 16.0, *)
+struct BlinkSessionShortcuts: AppShortcutsProvider {
+  static var appShortcuts: [AppShortcut] {
+    AppShortcut(intent: OpenTerminalSessionIntent(), phrases: ["Open a terminal with \(.applicationName)"], shortTitle: "Open Terminal", systemImageName: "terminal")
+    AppShortcut(intent: RunCommandOnHostIntent(), phrases: ["Run a command with \(.applicationName)"], shortTitle: "Run Command", systemImageName: "terminal")
+    AppShortcut(intent: RunScriptOnHostIntent(), phrases: ["Run a script with \(.applicationName)"], shortTitle: "Run Script", systemImageName: "scroll")
+  }
+}
