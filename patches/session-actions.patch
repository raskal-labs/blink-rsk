+// Adapted from blinksh/blink 7a427f3 SessionLink and FleetScript (GPL-3.0 + upstream terms).
+// URLs carry navigation only. Commands/scripts are private Shortcuts parameters;
+// every new connection/execution requires foreground confirmation.
+import Foundation
+
+struct SessionLink: Equatable {
+  enum Kind { case terminal, host, focus }
+  enum ValidationError: Error { case invalidLink, invalidHost, invalidID, invalidCommand }
+  let kind: Kind
+  let host: String?
+  let id: String?
+  let remoteCommand: String?
+  let preview: String?
+
+  static func isToken(_ value: String, limit: Int) -> Bool {
+    let allowed = CharacterSet(charactersIn: "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-")
+    return !value.isEmpty && value.count <= limit && value.unicodeScalars.allSatisfy { allowed.contains($0) }
+  }
+
+  static func validateHost(_ host: String) throws {
+    guard isToken(host, limit: 253), !host.hasPrefix("-"), !host.hasPrefix(".") else {
+      throw ValidationError.invalidHost
+    }
+  }
+
+  static func navigation(host: String?, id: String?) throws -> SessionLink {
+    if let id { guard isToken(id, limit: 64) else { throw ValidationError.invalidID } }
+    if let host {
+      try validateHost(host)
+      return SessionLink(kind: .host, host: host, id: id, remoteCommand: nil, preview: nil)
+    }
+    return SessionLink(kind: id == nil ? .terminal : .focus, host: nil, id: id, remoteCommand: nil, preview: nil)
+  }
+
+  static func parse(_ url: URL) throws -> SessionLink {
+    guard url.scheme?.lowercased() == "blinkshell",
+          let c = URLComponents(url: url, resolvingAgainstBaseURL: false),
+          c.user == nil, c.password == nil, c.port == nil, c.fragment == nil,
+          let action = c.host?.lowercased(), ["host", "focus"].contains(action) else {
+      throw ValidationError.invalidLink
+    }
+    let items = c.queryItems ?? []
+    // Reject cmd, script, key, duplicate/unknown arguments and hidden payloads.
+    guard items.count <= 1, items.allSatisfy({ $0.name == "id" && $0.value != nil }) else {
+      throw ValidationError.invalidLink
+    }
+    let id = items.first?.value
+    if action == "focus" {
+      guard c.path.isEmpty, id != nil else { throw ValidationError.invalidLink }
+      return try navigation(host: nil, id: id)
+    }
+    guard c.path.hasPrefix("/") else { throw ValidationError.invalidHost }
+    return try navigation(host: String(c.path.dropFirst()), id: id)
+  }
+
+  static func execution(host: String, command: String, interpreter: String? = nil) throws -> SessionLink {
+    try validateHost(host)
+    guard !command.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty,
+          command.utf8.count <= 8000 else { throw ValidationError.invalidCommand }
+    let remote: String
+    if let interpreter {
+      guard ["sh", "bash", "python3"].contains(interpreter),
+            !command.unicodeScalars.contains(where: { CharacterSet.controlCharacters.contains($0) && ![9, 10, 13].contains($0.value) }) else {
+        throw ValidationError.invalidCommand
+      }
+      let encoded = Data(command.utf8).base64EncodedString()
+      remote = "printf %s '\(encoded)' | base64 --decode | \(interpreter)"
+    } else {
+      guard command.rangeOfCharacter(from: .controlCharacters) == nil,
+            command.rangeOfCharacter(from: .newlines) == nil else { throw ValidationError.invalidCommand }
+      remote = command
+    }
+    return SessionLink(kind: .host, host: host, id: nil, remoteCommand: remote, preview: command)
+  }
+
+  // One shell token preserves the whole remote expression. It must never become
+  // a local pipeline/substitution in ios_system's initial command.
+  static func shellQuote(_ value: String) -> String {
+    "'" + value.replacingOccurrences(of: "'", with: "'\"'\"'") + "'"
+  }
+
+  var terminalCommand: String {
+    guard let host else { return "" }
+    let connect = "ssh -o StrictHostKeyChecking=yes " + host
+    guard let remoteCommand else { return connect }
+    return connect + " -- " + Self.shellQuote(remoteCommand)
+  }
+
+  func canReuseSession(_ exists: Bool) -> Bool {
+    exists && remoteCommand == nil
+  }
+}
