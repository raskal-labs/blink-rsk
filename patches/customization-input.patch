diff --git a/Blink/Terminal/WorkbenchInputDelivery.h b/Blink/Terminal/WorkbenchInputDelivery.h
new file mode 100644
--- /dev/null
+++ b/Blink/Terminal/WorkbenchInputDelivery.h
@@ -0,0 +1,11 @@
+// GPL-3.0 + Blink additional terms.
+#import <Foundation/Foundation.h>
+NS_ASSUME_NONNULL_BEGIN
+@interface WorkbenchInputDelivery : NSObject
+- (nullable instancetype)initWithFD:(int)fd status:(void (^)(NSUInteger pending, NSString * _Nullable error))status;
+- (BOOL)enqueue:(NSData *)data;
+- (void)cancelPending;
+- (void)invalidate;
+@property (readonly) NSUInteger pendingBytes;
+@end
+NS_ASSUME_NONNULL_END
diff --git a/Blink/Terminal/WorkbenchInputDelivery.m b/Blink/Terminal/WorkbenchInputDelivery.m
new file mode 100644
--- /dev/null
+++ b/Blink/Terminal/WorkbenchInputDelivery.m
@@ -0,0 +1,119 @@
+// GPL-3.0 + Blink additional terms. One serialized writer per input-pipe generation.
+#import "WorkbenchInputDelivery.h"
+#import "WorkbenchWriteStep.h"
+#import <fcntl.h>
+#import <dispatch/dispatch.h>
+
+@implementation WorkbenchInputDelivery {
+  int _fd;
+  dispatch_queue_t _queue;
+  dispatch_source_t _source;
+  dispatch_source_t _deadline;
+  NSMutableArray<NSData *> *_frames;
+  NSUInteger _offset, _pending, _epoch, _reservations, _framesEpoch;
+  BOOL _invalid, _running;
+  NSTimeInterval _lastProgress;
+  void (^_status)(NSUInteger, NSString *);
+}
+- (instancetype)initWithFD:(int)fd status:(void (^)(NSUInteger, NSString *))status {
+  if (!(self = [super init])) return nil;
+  _fd = dup(fd);
+  if (_fd < 0) return nil;
+  int flags = fcntl(_fd, F_GETFL);
+  if (flags < 0 || fcntl(_fd, F_SETFL, flags | O_NONBLOCK) < 0) { close(_fd); return nil; }
+#ifdef F_SETNOSIGPIPE
+  if (fcntl(_fd, F_SETNOSIGPIPE, 1) < 0) { close(_fd); return nil; }
+#endif
+  _status = [status copy];
+  _frames = [NSMutableArray array];
+  _queue = dispatch_queue_create("blink.workbench.input", DISPATCH_QUEUE_SERIAL);
+  _source = dispatch_source_create(DISPATCH_SOURCE_TYPE_WRITE, _fd, 0, _queue);
+  __weak WorkbenchInputDelivery *weak = self;
+  dispatch_source_set_event_handler(_source, ^{ [weak drain]; });
+  int ownedFD = _fd;
+  dispatch_source_set_cancel_handler(_source, ^{ close(ownedFD); });
+  _deadline = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, _queue);
+  dispatch_source_set_timer(_deadline, dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC), NSEC_PER_SEC, NSEC_PER_SEC / 10);
+  dispatch_source_set_event_handler(_deadline, ^{
+    WorkbenchInputDelivery *strong = weak;
+    if (strong && strong->_frames.count && NSDate.timeIntervalSinceReferenceDate - strong->_lastProgress > 15)
+      [strong fail:@"Input stopped making progress. Pending bytes cancelled; some input may already have reached the session."];
+  });
+  dispatch_resume(_deadline);
+  // Write source remains suspended while idle, avoiding an always-writable spin.
+  return self;
+}
+- (NSUInteger)pendingBytes { @synchronized(self) { return _pending; } }
+- (BOOL)enqueue:(NSData *)data {
+  if (!data.length) return YES;
+  @synchronized(self) {
+    if (_invalid || data.length > 4 * 1024 * 1024 || _pending + data.length > 4 * 1024 * 1024 || _reservations >= 2048) return NO;
+    _pending += data.length; _reservations++;
+    NSUInteger epoch = _epoch;
+    NSData *owned = [data copy];
+    dispatch_async(_queue, ^{
+      @synchronized(self) { if (self->_invalid || self->_epoch != epoch) return; }
+      if (!self->_frames.count) self->_framesEpoch = epoch;
+      [self->_frames addObject:owned];
+      self->_lastProgress = NSDate.timeIntervalSinceReferenceDate;
+      if (!self->_running) { self->_running = YES; dispatch_resume(self->_source); }
+      [self report:nil];
+    });
+  }
+  return YES;
+}
+- (void)report:(NSString *)error {
+  NSUInteger count = self.pendingBytes;
+  void (^status)(NSUInteger, NSString *) = _status;
+  dispatch_async(dispatch_get_main_queue(), ^{ status(count, error); });
+}
+- (void)pauseIfEmpty {
+  if (!_frames.count && _running) { dispatch_suspend(_source); _running = NO; }
+}
+- (void)fail:(NSString *)message {
+  [_frames removeAllObjects]; _offset = 0;
+  @synchronized(self) { _pending = 0; _reservations = 0; _epoch++; }
+  [self pauseIfEmpty]; [self report:message];
+}
+- (void)drain {
+  @synchronized(self) { if (_invalid) return; }
+  // Bound work per readiness event so large pastes do not starve cancellation.
+  for (int turn = 0; turn < 16 && _frames.count; turn++) {
+    NSUInteger epoch;
+    @synchronized(self) { if (_invalid || _framesEpoch != _epoch) return; epoch = _epoch; }
+    NSData *frame = _frames.firstObject;
+    WBWriteResult result = WBWriteStep(_fd, ((const char *)frame.bytes) + _offset, frame.length - _offset, write);
+    if (result.error) { [self fail:@"Input pipe closed or failed. Pending input cancelled; inspect the session before retrying."]; return; }
+    if (result.wait) break;
+    if (result.advanced) {
+      _offset += result.advanced;
+      @synchronized(self) { if (epoch == _epoch) _pending -= result.advanced; }
+      _lastProgress = NSDate.timeIntervalSinceReferenceDate;
+      if (_offset == frame.length) { [_frames removeObjectAtIndex:0]; _offset = 0; @synchronized(self) { if (epoch == _epoch) _reservations--; } }
+    }
+  }
+  [self pauseIfEmpty]; [self report:nil];
+}
+- (void)cancelPending {
+  @synchronized(self) {
+    if (_invalid) return;
+    _epoch++; _pending = 0; _reservations = 0;
+    dispatch_async(_queue, ^{
+      [self->_frames removeAllObjects]; self->_offset = 0;
+      [self pauseIfEmpty]; [self report:@"Pending input cancelled. Some bytes may already have been delivered."];
+    });
+  }
+}
+- (void)invalidate {
+  @synchronized(self) {
+    if (_invalid) return; _invalid = YES;
+    dispatch_async(_queue, ^{
+      [self->_frames removeAllObjects];
+      if (!self->_running) { dispatch_resume(self->_source); self->_running = YES; }
+      dispatch_source_cancel(self->_source); dispatch_source_cancel(self->_deadline);
+      self->_source = nil; self->_deadline = nil;
+      @synchronized(self) { self->_pending = 0; }
+    });
+  }
+}
+@end
diff --git a/Blink/Terminal/WorkbenchWriteStep.h b/Blink/Terminal/WorkbenchWriteStep.h
new file mode 100644
--- /dev/null
+++ b/Blink/Terminal/WorkbenchWriteStep.h
@@ -0,0 +1,20 @@
+// GPL-3.0 + Blink additional terms. Pure, injectable nonblocking write step.
+#ifndef BLINK_WORKBENCH_WRITE_STEP_H
+#define BLINK_WORKBENCH_WRITE_STEP_H
+#include <errno.h>
+#include <stddef.h>
+#include <sys/types.h>
+#include <unistd.h>
+typedef ssize_t (*WBWriteFunction)(int, const void *, size_t);
+typedef struct { size_t advanced; int error; int wait; } WBWriteResult;
+static inline WBWriteResult WBWriteStep(int fd, const void *bytes, size_t length, WBWriteFunction fn) {
+  WBWriteResult result = {0, 0, 0};
+  if (!length) return result;
+  ssize_t count = fn(fd, bytes, length > 16384 ? 16384 : length);
+  if (count > 0 && (size_t)count <= length) result.advanced = (size_t)count;
+  else if (count < 0 && errno == EINTR) { /* bounded caller retries on its next turn */ }
+  else if (count < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) result.wait = 1;
+  else result.error = count < 0 ? errno : EIO;
+  return result;
+}
+#endif
