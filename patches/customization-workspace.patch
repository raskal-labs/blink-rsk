+// MARK: Combined customization — one action catalogue across dock and workspace
+extension SpaceController {
+  private func workbenchSetup() {
+    workbenchDock.onAction = { [weak self] in self?.workbenchRun($0) }
+    workbenchDock.onCollapse = { [weak self] in
+      guard let self else { return }
+      self.workbenchDock.collapsed.toggle(); self.workbenchRefresh()
+    }
+    workbenchPad.onClose = {
+      WorkbenchStore.shared.edit { prefs in
+        var profile = prefs.profile; profile.dpad = false; prefs.updateProfile(profile)
+      }
+    }
+    workbenchPad.inputProvider = { [weak self] in
+      guard let self, self.foregroundActive, !self.isSnipsInputModeActive,
+            self.presentedViewController == nil else { return nil }
+      return self.currentDevice?.view?.browserView ?? self.currentDevice?.view?.webView
+    }
+    view.addSubview(workbenchDock); view.addSubview(workbenchPad)
+    WorkbenchStore.shared.$preferences.receive(on: RunLoop.main).sink { [weak self] _ in self?.workbenchRefresh() }.store(in: &workbenchSubscriptions)
+    NotificationCenter.default.publisher(for: NSNotification.Name("BlinkWorkbenchInputStatus"))
+      .receive(on: RunLoop.main).sink { [weak self] note in
+        guard let self, let device = note.object as? TermDevice, device === self.currentDevice else { return }
+        if let error = note.userInfo?["error"] as? String {
+          self.workbenchInputError = error
+          if self.presentedViewController == nil { self.showAlert(msg: error) }
+        }
+        self.workbenchRefresh()
+      }.store(in: &workbenchSubscriptions)
+    workbenchRefresh()
+  }
+  private func workbenchRefresh() {
+    guard isViewLoaded else { return }
+    workbenchDock.rebuild(WorkbenchStore.shared.preferences.profile, color: workbenchInputError == nil ? WorkbenchStore.shared.uiColor : .systemOrange,
+      state: workbenchState, pending: Int(currentDevice?.inputPendingBytes() ?? 0))
+    workbenchDock.overrideUserInterfaceStyle = WorkbenchStore.shared.preferences.appearance == "system" ? .unspecified : WorkbenchStore.shared.preferences.appearance == "dark" ? .dark : .light
+    view.setNeedsLayout()
+  }
+  private func workbenchLayoutDock() {
+    guard workbenchDock.superview != nil else { return }
+    let prefs = WorkbenchStore.shared.preferences
+    let profile = prefs.profile
+    let lockedLayout = currentTerm()?.termView.isLayoutLocked() ?? false
+    let hidden = !prefs.dockVisible || _isSnipsInputModeActive || lockedLayout || sceneRole != .windowApplication
+    workbenchDock.isHidden = hidden
+    let safe = _overlay.frame.insetBy(dx: 12, dy: 8)
+    guard safe.width >= CGFloat(profile.controlSize * 3 + 16), safe.height >= CGFloat(profile.controlSize + 16) else {
+      workbenchDock.isHidden = true; workbenchPad.isHidden = true; workbenchPad.stopRepeating()
+      currentTerm()?.termView.constraintManager?.workbenchBottomInset = 0
+      return
+    }
+    if !workbenchDock.collapsed && safe.width < CGFloat(profile.controlSize * 3 + 64) {
+      workbenchDock.collapsed = true; workbenchRefresh()
+    }
+    let height = CGFloat(profile.controlSize + 8)
+    let width = workbenchDock.collapsed ? min(safe.width, CGFloat(profile.controlSize * 3 + 16)) : min(safe.width, 720)
+    let x = profile.trailing ? safe.maxX - width : safe.minX
+    workbenchDock.frame = CGRect(x: x, y: safe.maxY - height, width: max(0, width), height: height)
+    currentTerm()?.termView.constraintManager?.workbenchBottomInset = hidden ? 0 : height + 16
+    workbenchPad.isHidden = !profile.dpad || _isSnipsInputModeActive || lockedLayout || sceneRole != .windowApplication
+    if workbenchPad.isHidden { workbenchPad.stopRepeating() }
+    let area = CGRect(x: safe.minX, y: safe.minY, width: max(0, safe.width), height: max(0, safe.height - (hidden ? 0 : height + 12)))
+    if area.width < 168 || area.height < 168 { workbenchPad.isHidden = true; workbenchPad.stopRepeating() }
+    if workbenchPad.frame.origin == .zero { workbenchPad.center = CGPoint(x: area.maxX - 90, y: area.maxY - 90) }
+    workbenchPad.constrainPosition(to: area)
+    view.bringSubviewToFront(workbenchDock); view.bringSubviewToFront(workbenchPad)
+  }
+  private func workbenchApplyInteraction() {
+    guard let terminal = currentTerm() else { return }
+    // Snips owns the responder capability; browsing suppresses touch refocus and
+    // the software surface without disabling intentional hardware-key events.
+    terminal.shouldBlockFirstResponder = _isSnipsInputModeActive
+    terminal.termView.webView?.workbenchSelecting = workbenchState.selecting
+    terminal.termView.webView?.evaluateJavaScript("term_workbenchSetInteraction(\(workbenchState.selecting ? "true" : "false"))", completionHandler: nil)
+    terminal.termView.browserView?.workbenchSelecting = workbenchState.selecting
+    terminal.termView.webView?.workbenchSuppressSoftwareKeyboard = workbenchState.suppressSoftwareKeyboard
+    terminal.termView.browserView?.workbenchSuppressSoftwareKeyboard = workbenchState.suppressSoftwareKeyboard
+  }
+  func workbenchTerminalReady(_ terminal: TermController) {
+    if terminal === currentTerm() { workbenchApplyInteraction() }
+  }
+  func workbenchRestoreInput() {
+    workbenchApplyInteraction()
+    if !_isSnipsInputModeActive { _attachInputToCurrentTerm() }
+    workbenchRefresh()
+  }
+  func workbenchShow() {
+    guard presentedViewController == nil, !_isSnipsInputModeActive, !_spaceControllerAnimating else { return }
+    workbenchPad.stopRepeating()
+    currentTerm()?.resignInput()
+    let context = WorkbenchContext(space: self)
+    let controller = WorkbenchPresentation(rootView: WorkbenchRootView(context: context))
+    controller.onInteractiveDismiss = { [weak self] in self?.workbenchRestoreInput() }
+    controller.presentationController?.delegate = controller
+    controller.modalPresentationStyle = .pageSheet
+    if let sheet = controller.sheetPresentationController {
+      sheet.detents = [.large()]; sheet.prefersGrabberVisible = true
+    }
+    present(controller, animated: true)
+  }
+  func workbenchInputStatus() -> String? { workbenchInputError }
+  func workbenchAcknowledgeInputError() { workbenchInputError = nil; workbenchRefresh() }
+  func workbenchSessions() -> [WorkbenchSessionRow] {
+    _viewportsKeys.compactMap { key in
+      guard let terminal: TermController = SessionRegistry.shared.sessionFromIndexWith(key: key) else { return nil }
+      let label = WorkbenchStore.shared.preferences.labels[key.uuidString]
+      let title = label.flatMap { $0.isEmpty ? nil : $0 } ?? terminal.title.flatMap { $0.isEmpty ? nil : $0 } ?? "Terminal"
+      let detail = terminal.workbenchCommandContext + (workbenchTargets[key].map { " · " + $0 } ?? "")
+      return WorkbenchSessionRow(id: key, title: title, detail: detail, selected: key == _currentKey)
+    }
+  }
+  func workbenchFocus(_ key: UUID) { _moveToShell(key: key) }
+  func workbenchClose(_ key: UUID) {
+    guard !_spaceControllerAnimating, _viewportsKeys.contains(key), !_isSnipsInputModeActive else { return }
+    if key == _currentKey { _closeCurrentSpace(); return }
+    guard let terminal: TermController = SessionRegistry.shared.sessionFromIndexWith(key: key) else { return }
+    workbenchPad.stopRepeating()
+    terminal.terminate(); terminal.delegate = nil
+    _viewportsKeys.removeAll { $0 == key }; SessionRegistry.shared.remove(forKey: key)
+    linkedSessions = linkedSessions.filter { $0.value != key }
+    workbenchTargets.removeValue(forKey: key)
+    WorkbenchStore.shared.edit { $0.labels.removeValue(forKey: key.uuidString) }
+    workbenchRefresh()
+  }
+  func workbenchReorder(_ source: IndexSet, to destination: Int) {
+    guard !_spaceControllerAnimating, !_isSnipsInputModeActive,
+          source.allSatisfy({ _viewportsKeys.indices.contains($0) }), (0..._viewportsKeys.count).contains(destination) else { return }
+    workbenchPad.stopRepeating(); _viewportsKeys.move(fromOffsets: source, toOffset: destination)
+  }
+  func workbenchConnect(_ host: String, mosh: Bool) {
+    Task { @MainActor in
+      do {
+        let link = try SessionLink.opening(host: host, id: nil, transport: mosh ? .mosh : .ssh, command: nil, reuse: false)
+        _ = try await openSessionLink(link)
+        WorkbenchStore.shared.edit { $0.visitHost(host) }
+      } catch { showAlert(msg: SessionActionRunner.describe(error).localizedDescription) }
+    }
+  }
+  func workbenchOpenFolder(_ name: String) {
+    do {
+      guard let location = try BookmarkedLocationsManager.default.getLocations().first(where: { $0.name == name }),
+            location.isAvailable, let url = location.url else {
+        showAlert(msg: "Folder unavailable. Retry or reselect it in Bookmarks; its saved record has been retained."); return
+      }
+      _newShellAction(command: "cd " + SessionLink.shellQuote(url.path))
+    } catch { showAlert(msg: "Bookmarks could not be read. Saved records were preserved.") }
+  }
+  func workbenchApplyDraft(_ style: TerminalStyle) {
+    guard let terminal = currentTerm() else { return }
+    let state = terminal.termView.termUIState
+    state.themeName = style.themeName; state.fontName = style.fontName; state.fontSize = Int(style.fontSize)
+    state.enableBold = UInt(style.boldMode.rawValue); state.boldAsBright = style.boldAsBright
+    terminal.termView.applyTermUIState(state); terminal.termView.setCursorBlink(style.cursorBlink)
+    workbenchRestoreInput()
+  }
+  func workbenchRun(_ action: WorkbenchAction) {
+    guard foregroundActive, presentedViewController == nil, !_isSnipsInputModeActive else { return }
+    let terminal = currentTerm()
+    let input = currentDevice?.view?.browserView ?? currentDevice?.view?.webView
+    switch action {
+    case .workspace: workbenchShow()
+    case .keyboard:
+      let softwareVisible = view.keyboardLayoutGuide.layoutFrame.height > view.safeAreaInsets.bottom + 60
+      if workbenchState.suppressSoftwareKeyboard || !softwareVisible { workbenchState.showKeyboard() }
+      else { workbenchState.keyboardHidden = true }
+      workbenchRestoreInput()
+    case .keyboardLock:
+      workbenchState.keyboardLocked.toggle()
+      if !workbenchState.keyboardLocked { workbenchState.keyboardHidden = false }
+      workbenchRestoreInput()
+    case .interaction:
+      workbenchState.selecting.toggle(); workbenchRestoreInput()
+    case .selectAll:
+      guard terminal?.termView.browserView == nil else { showAlert(msg: "Retained terminal selection is not available in browser content."); return }
+      workbenchState.selecting = true; workbenchApplyInteraction()
+      terminal?.termView.webView.evaluateJavaScript("term_workbenchSelectAll()") { [weak self] _, error in
+        if let error { self?.showAlert(msg: "Selection could not be completed: " + error.localizedDescription) }
+      }
+    case .copy: terminal?.termView.copy(self)
+    case .copyRaw: terminal?.termView.copyRaw(self)
+    case .copyAll, .copyScreen: workbenchExport(screenOnly: action == .copyScreen)
+    case .bottom: terminal?.termView.webView.evaluateJavaScript("term_workbenchBottom()", completionHandler: nil)
+    case .paste: if let text = UIPasteboard.general.string, let terminal { workbenchReviewPaste(text, terminal: terminal) }
+    case .cancelPaste: currentDevice?.cancelPendingInput()
+    case .snippets: showSnippetsAction()
+    case .scratch: showScratchAction()
+    case .newSession: _newShellAction()
+    case .nextSession: _advanceShellCycling(by: 1)
+    case .previousSession: _advanceShellCycling(by: -1)
+    case .escape: input?.kbView.sendKey(.esc)
+    case .tab: input?.kbView.sendKey(.tab)
+    case .control: input?.kbView.workbenchToggleModifier(.ctrl)
+    case .alternate: input?.kbView.workbenchToggleModifier(.alt)
+    case .up: input?.kbView.sendKey(.up)
+    case .down: input?.kbView.sendKey(.down)
+    case .left: input?.kbView.sendKey(.left)
+    case .right: input?.kbView.sendKey(.right)
+    case .layoutMenu: _toggleQuickActionActionWith(receiver: self)
+    }
+    workbenchRefresh()
+  }
+  func workbenchReviewPaste(_ text: String, terminal: TermController) {
+    guard terminal === currentTerm(), !_spaceControllerAnimating, !_isSnipsInputModeActive else { return }
+    guard text.utf8.count <= 4 * 1024 * 1024 else { showAlert(msg: "Paste exceeds 4 MiB and was not sent."); return }
+    let needsReview = WorkbenchPastePolicy.needsReview(text, enabled: WorkbenchStore.shared.preferences.previewPaste)
+    if !needsReview { terminal.termView.workbenchPasteConfirmed(text); return }
+    guard presentedViewController == nil else { return }
+    let alert = UIAlertController(title: "Review Paste", message: WorkbenchPastePolicy.preview(text) + (text.count > 3000 ? "\n… (preview shortened; full reviewed text goes through terminal paste handling)" : "") + "\n\n\(text.utf8.count) UTF-8 bytes. Existing terminal paste/bracketed-paste rules apply. Newlines may execute commands; cancelling later cannot retract delivered input.", preferredStyle: .alert)
+    alert.addAction(UIAlertAction(title: "Cancel", style: .cancel))
+    alert.addAction(UIAlertAction(title: "Paste Reviewed Text", style: .default) { [weak self, weak terminal] _ in
+      guard let self, let terminal, terminal === self.currentTerm(), !self._isSnipsInputModeActive else { return }
+      terminal.termView.workbenchPasteConfirmed(text)
+    })
+    present(alert, animated: true)
+  }
+  private func workbenchExport(screenOnly: Bool) {
+    guard let terminal = currentTerm(), terminal.termView.browserView == nil else { showAlert(msg: "Retained text export is available only in terminal content."); return }
+    workbenchCapture?.cancel()
+    let key = terminal.meta.key
+    let progress = UIAlertController(title: "Capturing Retained Text", message: "Only text retained by this terminal is available. Output arriving during capture can change the buffer.", preferredStyle: .alert)
+    progress.addAction(UIAlertAction(title: "Cancel", style: .cancel) { [weak self] _ in self?.workbenchCapture?.cancel() })
+    present(progress, animated: true)
+    workbenchCapture = Task { @MainActor [weak self, weak terminal] in
+      guard let self, let terminal else { return }
+      do {
+        var offset = 0, expected: Int?, result = ""
+        var continued = false
+        while true {
+          try Task.checkCancellation()
+          guard self._currentKey == key else { throw CancellationError() }
+          let js = "term_workbenchRows(\(screenOnly ? "true" : "false"),\(offset),128)"
+          let raw: Any? = try await withCheckedThrowingContinuation { continuation in
+            terminal.termView.webView.evaluateJavaScript(js) { value, error in
+              if let error { continuation.resume(throwing: error) } else { continuation.resume(returning: value) }
+            }
+          }
+          guard let data = raw as? [String: Any], let text = data["text"] as? String,
+                let next = data["next"] as? Int, let total = data["total"] as? Int,
+                next >= offset, total >= next, total <= 200000 else { throw ShortcutFailure(message: "Terminal capture returned invalid or excessive rows.") }
+          if let expected, expected != total { throw ShortcutFailure(message: "The retained row count changed during capture. Pause output and retry.") }
+          expected = total
+          if offset > 0 && !continued { result += "\n" }
+          guard result.utf8.count + text.utf8.count <= 4 * 1024 * 1024 else { throw ShortcutFailure(message: "Capture exceeds 4 MiB. No partial output was copied.") }
+          result += text; continued = data["continued"] as? Bool ?? false
+          if next == total { break }
+          guard next > offset else { throw ShortcutFailure(message: "Capture made no progress.") }
+          offset = next
+          await Task.yield()
+        }
+        try Task.checkCancellation()
+        progress.dismiss(animated: true) { [weak self] in self?.workbenchShowOutput(result) }
+      } catch {
+        progress.dismiss(animated: true) { [weak self] in
+          if !(error is CancellationError) { self?.showAlert(msg: error.localizedDescription) }
+        }
+      }
+    }
+  }
+  private func workbenchShowOutput(_ text: String) {
+    let controller = WorkbenchPresentation(rootView: WorkbenchOutputView(text: text, share: { [weak self] in
+      guard let self else { return }
+      let folder = FileManager.default.temporaryDirectory.appendingPathComponent("Blink-Export-" + UUID().uuidString, isDirectory: true)
+      let file = folder.appendingPathComponent("Retained Terminal Text.txt")
+      do {
+        try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: false)
+        try Data(text.utf8).write(to: file, options: [.atomic, .completeFileProtection])
+      } catch {
+        try? FileManager.default.removeItem(at: folder)
+        self.presentedViewController?.dismiss(animated: true) { self.showAlert(msg: "Output could not be staged for sharing.") }; return
+      }
+      let sheet = UIActivityViewController(activityItems: [file], applicationActivities: nil)
+      sheet.completionWithItemsHandler = { _, _, _, _ in try? FileManager.default.removeItem(at: folder) }
+      if let popover = sheet.popoverPresentationController {
+        popover.sourceView = self.presentedViewController?.view ?? self.view
+        popover.sourceRect = CGRect(x: popover.sourceView!.bounds.midX, y: popover.sourceView!.bounds.midY, width: 1, height: 1)
+      }
+      self.presentedViewController?.present(sheet, animated: true)
+    }, close: { [weak self] in self?.dismiss(animated: true) { self?.workbenchRestoreInput() } }))
+    controller.onInteractiveDismiss = { [weak self] in self?.workbenchRestoreInput() }
+    controller.presentationController?.delegate = controller
+    present(controller, animated: true)
+  }
+}
