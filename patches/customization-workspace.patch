+// GPL-3.0 + Blink additional terms. Native workspace and customization surfaces.
+import SwiftUI
+import UIKit
+import Combine
+import BlinkConfig
+
+@MainActor
+final class WorkbenchStore: ObservableObject {
+  static let shared = WorkbenchStore()
+  static let key = "blink.rsk.workbench.v1"
+  @Published private(set) var preferences = WorkbenchPreferences()
+  @Published private(set) var storageError: String?
+  @Published private(set) var editError: String?
+  private let defaults: UserDefaults
+  init(defaults: UserDefaults = .standard) {
+    self.defaults = defaults
+    if let data = defaults.data(forKey: Self.key) {
+      do { preferences = try WorkbenchPreferences.decode(data) }
+      catch { storageError = "Saved customization could not be read. It has been preserved. Reset only if you want to replace it." }
+    }
+  }
+  func edit(_ change: (inout WorkbenchPreferences) -> Void) {
+    guard storageError == nil else { return }
+    var next = preferences; change(&next)
+    do {
+      next = try next.validated()
+      defaults.set(try JSONEncoder().encode(next), forKey: Self.key)
+      preferences = next; editError = nil
+    } catch { editError = "Customization was not saved because it is invalid. Previous settings remain stored." }
+  }
+  func resetExplicitly() {
+    defaults.removeObject(forKey: Self.key); storageError = nil; preferences = WorkbenchPreferences()
+  }
+  var color: Color {
+    switch preferences.accent {
+    case "violet": return .purple
+    case "green": return .green
+    case "orange": return .orange
+    case "pink": return .pink
+    default: return .cyan
+    }
+  }
+  var uiColor: UIColor { UIColor(color) }
+  var colorScheme: ColorScheme? { preferences.appearance == "system" ? nil : preferences.appearance == "light" ? .light : .dark }
+}
+
+struct WorkbenchSessionRow: Identifiable {
+  var id: UUID
+  var title: String
+  var detail: String
+  var selected: Bool
+}
+@MainActor
+final class WorkbenchContext: ObservableObject {
+  weak var space: SpaceController?
+  @Published var sessions: [WorkbenchSessionRow] = []
+  @Published var hosts: [String] = []
+  @Published var folders: [BookmarkedLocation] = []
+  @Published var pendingBytes = 0
+  @Published var bookmarkError: String?
+  @Published var inputError: String?
+  init(space: SpaceController) { self.space = space; refresh() }
+  func refresh() {
+    sessions = space?.workbenchSessions() ?? []
+    hosts = (BKHosts.allHosts() ?? []).compactMap { $0.host }.sorted()
+    do { folders = try BookmarkedLocationsManager.default.getLocations(); bookmarkError = nil }
+    catch { bookmarkError = "Bookmarks could not be read. Saved records were preserved; open Bookmarks to retry." }
+    pendingBytes = Int(space?.currentDevice?.inputPendingBytes() ?? 0)
+    inputError = space?.workbenchInputStatus()
+  }
+  func leave(_ operation: @escaping (SpaceController) -> Void) {
+    guard let space else { return }
+    space.dismiss(animated: true) {
+      operation(space)
+      if space.presentedViewController == nil { space.workbenchRestoreInput() }
+    }
+  }
+}
+
+@MainActor
+struct WorkbenchRootView: View {
+  @ObservedObject var store = WorkbenchStore.shared
+  @ObservedObject var context: WorkbenchContext
+  @State private var query = ""
+  @State private var rename: WorkbenchSessionRow?
+  @State private var renameText = ""
+  @State private var closing: WorkbenchSessionRow?
+  @State private var reset = false
+  @State private var newProfileName = ""
+  @State private var editingProfile: WorkbenchProfile?
+  @State private var selectedTab = 0
+  @State private var newStyleName = ""
+  @State private var styleRevision = 0
+  @State private var styleChoice = TerminalStyleStore.shared.selectedStyle.id
+  @State private var editedStyle = TerminalStyleStore.shared.selectedStyle
+  @ObservedObject private var styles = TerminalStyleStore.shared
+  private let timer = Timer.publish(every: 1, on: .main, in: .common).autoconnect()
+
+  var body: some View {
+    NavigationView {
+      TabView(selection: $selectedTab) {
+        workspace.tabItem { Label("Workspace", systemImage: "square.grid.2x2") }.tag(0)
+        sessions.tabItem { Label("Sessions", systemImage: "rectangle.stack") }.tag(1)
+        controls.tabItem { Label("Controls", systemImage: "slider.horizontal.3") }.tag(2)
+        appearance.tabItem { Label("Appearance", systemImage: "paintpalette") }.tag(3)
+      }
+      .navigationTitle("Workspace")
+      .navigationBarTitleDisplayMode(.inline)
+      .searchable(text: $query, prompt: "Actions, hosts, folders and sessions")
+      .toolbar {
+        ToolbarItem(placement: .cancellationAction) { Button("Terminal") { context.leave { $0.workbenchRestoreInput() } } }
+      }
+    }
+    .navigationViewStyle(.stack)
+    .tint(store.color)
+    .preferredColorScheme(store.colorScheme)
+    .onReceive(timer) { _ in context.refresh() }
+    .onChange(of: styles.styles) { _ in styleRevision += 1 }
+    .onChange(of: styleChoice) { id in if let style = styles.style(for: id) { editedStyle = style; styleRevision += 1 } }
+    .alert("Rename session", isPresented: Binding(get: { rename != nil }, set: { if !$0 { rename = nil } })) {
+      TextField("Label", text: $renameText)
+      Button("Save") {
+        if let rename { store.edit { $0.labels[rename.id.uuidString] = String(renameText.prefix(64)) }; context.refresh() }
+        rename = nil
+      }
+      Button("Cancel", role: .cancel) { rename = nil }
+    } message: { Text("User labels do not change terminal titles or Shortcuts session names.") }
+    .confirmationDialog("Close terminal?", isPresented: Binding(get: { closing != nil }, set: { if !$0 { closing = nil } })) {
+      Button("Close Terminal", role: .destructive) {
+        if let closing { context.leave { $0.workbenchClose(closing.id) } }
+        closing = nil
+      }
+      Button("Cancel", role: .cancel) { closing = nil }
+    } message: { Text("This closes the local terminal and its command. Remote session persistence depends on the remote application; closing is not a guaranteed detach.") }
+    .confirmationDialog("Reset workspace customization?", isPresented: $reset) {
+      Button("Reset Customization", role: .destructive) { store.resetExplicitly() }
+    } message: { Text("Replaces only workspace/dock preferences. Terminal styles, keys, hosts and bookmarks are preserved.") }
+  }
+  private func matches(_ text: String) -> Bool { query.isEmpty || text.localizedCaseInsensitiveContains(query) }
+  private var workspace: some View {
+    List {
+      Section {
+        VStack(alignment: .leading, spacing: 8) {
+          Text("YOUR TERMINAL, YOUR WORKSPACE").font(.caption).fontWeight(.semibold).foregroundColor(store.color)
+          Text("Connect. Work. Return.").font(store.preferences.compact ? .title3 : .largeTitle).bold()
+          Text("Local terminals, saved destinations and explicit actions in one place.").font(.subheadline).foregroundColor(.secondary)
+        }.padding(.vertical, store.preferences.compact ? 4 : 16)
+      }
+      Section("Actions") {
+        ForEach(WorkbenchAction.allCases.filter { matches($0.title) }) { action in
+          Button { context.leave { $0.workbenchRun(action) } } label: { Label(action.title, systemImage: action.symbol) }
+        }
+      }
+      if context.pendingBytes > 0 || context.inputError != nil {
+        Section("Input delivery") {
+          if let error = context.inputError {
+            Text(error).foregroundColor(.orange)
+            Button("Acknowledge") { context.space?.workbenchAcknowledgeInputError(); context.refresh() }
+          }
+          Text("\(context.pendingBytes) bytes pending")
+          Button("Cancel Pending Input", role: .destructive) { context.space?.currentDevice?.cancelPendingInput() }
+        }
+      }
+      hostSection("Favorites", names: store.preferences.favoriteHosts)
+      hostSection("Recent hosts", names: store.preferences.recentHosts)
+      hostSection("Saved hosts", names: context.hosts)
+      Section("Saved folders") {
+        if let error = context.bookmarkError { Text(error).foregroundColor(.orange) }
+        ForEach(context.folders.filter { matches($0.name) }) { folder in
+          Button { context.leave { $0.workbenchOpenFolder(folder.name) } } label: {
+            HStack { Label(folder.name, systemImage: "folder"); Spacer(); if !folder.isAvailable { Text("Unavailable").foregroundColor(.secondary) } }
+          }
+        }
+      }
+      Section {
+        Button("Manage Hosts, Bookmarks and Settings") { context.leave { $0.showConfigAction() } }
+        Text("Saved profiles are destinations, not a live-connection indicator. Unavailable bookmarks remain saved.").font(.footnote).foregroundColor(.secondary)
+      }
+    }.listStyle(.insetGrouped)
+  }
+  private func hostSection(_ title: String, names: [String]) -> some View {
+    Section(title) {
+      ForEach(names.filter { context.hosts.contains($0) && matches($0) }, id: \.self) { host in
+        HStack {
+          Menu {
+            Button("New SSH Terminal") { context.leave { $0.workbenchConnect(host, mosh: false) } }
+            Button("New Mosh Terminal") { context.leave { $0.workbenchConnect(host, mosh: true) } }
+          } label: { Label(host, systemImage: "server.rack") }
+          Spacer()
+          Button {
+            store.edit { prefs in
+              if prefs.favoriteHosts.contains(host) { prefs.favoriteHosts.removeAll { $0 == host } }
+              else { prefs.favoriteHosts.append(host) }
+            }
+          } label: { Image(systemName: store.preferences.favoriteHosts.contains(host) ? "star.fill" : "star") }
+          .buttonStyle(.borderless).accessibilityLabel("Toggle favorite for " + host)
+        }
+      }
+    }
+  }
+  private var sessions: some View {
+    List {
+      Section("This window") {
+        ForEach(context.sessions.filter { matches($0.title + " " + $0.detail) }) { session in
+          HStack {
+            Button { context.leave { $0.workbenchFocus(session.id) } } label: {
+              VStack(alignment: .leading, spacing: 4) {
+                Label(session.title, systemImage: session.selected ? "terminal.fill" : "terminal")
+                Text(session.detail).font(.caption).foregroundColor(.secondary)
+              }
+            }
+            Spacer()
+            Menu {
+              Button("Rename Label") { renameText = session.title; rename = session }
+              Button("Close Terminal…", role: .destructive) { closing = session }
+            } label: { Image(systemName: "ellipsis.circle") }.buttonStyle(.borderless)
+          }
+        }.onMove { source, destination in
+          guard query.isEmpty else { return }
+          context.space?.workbenchReorder(source, to: destination); context.refresh()
+        }
+      }
+      Section {
+        Button("New Local Terminal") { context.leave { $0.newShellAction() } }
+        Text("Use the terminal application's own detach/disconnect commands when you want to keep a remote process alive. Switch and close operate on the selected local terminal only.").font(.footnote).foregroundColor(.secondary)
+      }
+    }.toolbar { EditButton().disabled(!query.isEmpty) }.listStyle(.insetGrouped)
+  }
+  private var controls: some View {
+    List {
+      if let error = store.storageError ?? store.editError { Section { Text(error).foregroundColor(.orange) } }
+      Section("Dock") {
+        Toggle("Show touch dock", isOn: pref(\.dockVisible))
+        Picker("Profile", selection: pref(\.selectedProfile)) {
+          ForEach(store.preferences.profiles) { Text($0.name).tag($0.id) }
+        }
+        Toggle("Separate D-pad", isOn: profile(\.dpad))
+        Toggle("Dock on trailing side", isOn: profile(\.trailing))
+        Stepper("Control size: \(store.preferences.profile.controlSize)", value: profile(\.controlSize), in: 44...72, step: 4)
+        Button("Edit profile actions") { editingProfile = store.preferences.profile }
+      }
+      Section("New profile") {
+        TextField("Profile name", text: $newProfileName)
+        Button("Duplicate Current Profile") {
+          guard !newProfileName.trimmingCharacters(in: .whitespaces).isEmpty else { return }
+          store.edit { prefs in
+            var copy = prefs.profile; copy.id = UUID(); copy.name = String(newProfileName.prefix(64))
+            prefs.profiles.append(copy); prefs.selectedProfile = copy.id
+          }; newProfileName = ""
+        }.disabled(store.preferences.profiles.count >= 20 || newProfileName.isEmpty)
+        Button("Delete Current Profile", role: .destructive) {
+          store.edit { prefs in
+            guard prefs.profiles.count > 1 else { return }
+            let id = prefs.selectedProfile; prefs.profiles.removeAll { $0.id == id }; prefs.selectedProfile = prefs.profiles[0].id
+          }
+        }.disabled(store.preferences.profiles.count == 1)
+      }
+      Section("Input") {
+        Toggle("Review multiline or control-character paste", isOn: pref(\.previewPaste))
+        Text("Input delivery is ordered and capped at 4 MiB pending. Cancel cannot retract bytes already sent. Keyboard lock suppresses the software keyboard; Select/Scroll prevents touch refocus while preserving deliberate controls.").font(.footnote).foregroundColor(.secondary)
+      }
+      Section("Discoverability") {
+        Text("Workspace is always available from the dock's grid button or the existing bottom-edge double tap. The dock chevron collapses it. Keyboard explicitly reopens input and clears keyboard lock. Session names in Shortcuts remain separate from the labels here.").font(.footnote)
+        Button("Reset Customization…", role: .destructive) { reset = true }
+      }
+    }
+    .sheet(item: $editingProfile) { value in WorkbenchProfileEditor(profile: value, store: store) }
+    .listStyle(.insetGrouped)
+  }
+  private var appearance: some View {
+    List {
+      Section("Workspace appearance") {
+        Picker("Appearance", selection: pref(\.appearance)) {
+          Text("System").tag("system"); Text("Light").tag("light"); Text("Dark").tag("dark")
+        }
+        Picker("Accent", selection: pref(\.accent)) {
+          ForEach(["cyan", "violet", "green", "orange", "pink"], id: \.self) { Text($0.capitalized).tag($0) }
+        }
+        Toggle("Compact workspace", isOn: pref(\.compact))
+      }
+      Section("Terminal presets") {
+        Picker("Preset", selection: $styleChoice) { ForEach(styles.allStyles) { Text($0.name).tag($0.id) } }
+        if styles.style(for: styleChoice) != nil {
+          let style = editedStyle
+          VStack(alignment: .leading, spacing: 8) {
+            Text(style.name).font(.headline)
+            Text("\(style.themeName) · \(style.fontName) · \(Int(style.fontSize)) px").font(.caption).foregroundColor(.secondary)
+            TerminalPreviewCell(style: style, revision: styleRevision).frame(height: 180)
+          }
+          Button("Apply to Current Terminal") { context.leave { $0.workbenchApplyDraft(style) } }
+          Button("Use for Future Terminals") {
+            if styles.style(for: style.id) == style { styles.setSelected(style.id) }
+            else {
+              let copy = styles.createStyle(name: style.name + " Custom", themeName: style.themeName, fontName: style.fontName,
+                fontSize: style.fontSize, cursorBlink: style.cursorBlink, boldMode: style.boldMode, boldAsBright: style.boldAsBright)
+              styles.setSelected(copy.id); styleChoice = copy.id
+            }
+          }
+          TextField("New preset name", text: $newStyleName)
+          Button("Duplicate as Named Preset") {
+            guard !newStyleName.isEmpty else { return }
+            let copy = styles.createStyle(name: String(newStyleName.prefix(64)), themeName: style.themeName, fontName: style.fontName,
+              fontSize: style.fontSize, cursorBlink: style.cursorBlink, boldMode: style.boldMode, boldAsBright: style.boldAsBright)
+            styleChoice = copy.id; newStyleName = ""
+          }
+          Group {
+            Stepper("Font size: \(Int(style.fontSize)) px", value: styleBinding(style, \.fontSize), in: 6...48)
+            Toggle("Blink cursor", isOn: styleBinding(style, \.cursorBlink))
+            Toggle("Bold as bright", isOn: styleBinding(style, \.boldAsBright))
+            Picker("Bold", selection: styleBinding(style, \.boldMode)) {
+              Text("Auto").tag(TerminalStyle.BoldMode.auto); Text("On").tag(TerminalStyle.BoldMode.on); Text("Off").tag(TerminalStyle.BoldMode.off)
+            }
+            Picker("Theme", selection: styleBinding(style, \.themeName)) {
+              ForEach((BKTheme.all() as? [BKTheme]) ?? [], id: \.name) { Text($0.name).tag($0.name) }
+            }
+            Picker("Font", selection: styleBinding(style, \.fontName)) {
+              ForEach((BKFont.all() as? [BKFont]) ?? [], id: \.name) { Text($0.name).tag($0.name) }
+            }
+          }
+        }
+        Text("Editing changes only this draft preview. Apply to Current, choose Future, or save a new named preset explicitly. The live terminal preview uses the installed theme and font.").font(.footnote).foregroundColor(.secondary)
+      }
+    }.listStyle(.insetGrouped)
+  }
+  private func pref<Value>(_ key: WritableKeyPath<WorkbenchPreferences, Value>) -> Binding<Value> {
+    Binding(get: { store.preferences[keyPath: key] }, set: { value in store.edit { $0[keyPath: key] = value } })
+  }
+  private func profile<Value>(_ key: WritableKeyPath<WorkbenchProfile, Value>) -> Binding<Value> {
+    Binding(get: { store.preferences.profile[keyPath: key] }, set: { value in
+      store.edit { prefs in var p = prefs.profile; p[keyPath: key] = value; prefs.updateProfile(p) }
+    })
+  }
+  private func styleBinding<Value>(_ style: TerminalStyle, _ key: WritableKeyPath<TerminalStyle, Value>) -> Binding<Value> {
+    Binding(get: { editedStyle[keyPath: key] }, set: { value in
+      editedStyle[keyPath: key] = value; styleRevision += 1
+    })
+  }
+}
+
+@MainActor
+struct WorkbenchProfileEditor: View {
+  @State var profile: WorkbenchProfile
+  @ObservedObject var store: WorkbenchStore
+  @Environment(\.dismiss) var dismiss
+  var body: some View {
+    NavigationView {
+      List {
+        TextField("Profile name", text: $profile.name)
+        Section("Visible actions — drag to reorder") {
+          ForEach(profile.actions) { action in Label(action.title, systemImage: action.symbol) }
+            .onMove { profile.actions.move(fromOffsets: $0, toOffset: $1) }
+            .onDelete { profile.actions.remove(atOffsets: $0) }
+        }
+        Section("Add action") {
+          ForEach(WorkbenchAction.allCases.filter { !profile.actions.contains($0) }) { action in
+            Button { profile.actions.append(action) } label: { Label(action.title, systemImage: action.symbol) }
+          }
+        }
+      }.environment(\.editMode, .constant(.active))
+      .navigationTitle("Control Profile")
+      .toolbar {
+        ToolbarItem(placement: .cancellationAction) { Button("Cancel") { dismiss() } }
+        ToolbarItem(placement: .confirmationAction) { Button("Save") { store.edit { $0.updateProfile(profile) }; dismiss() }.disabled(profile.name.isEmpty || profile.name.count > 64) }
+      }
+    }.navigationViewStyle(.stack)
+  }
+}
+
+@MainActor
+struct WorkbenchOutputView: View {
+  let text: String
+  let share: () -> Void
+  let close: () -> Void
+  var body: some View {
+    NavigationView {
+      ScrollView {
+        Text(String(text.prefix(65536))).font(.system(.body, design: .monospaced)).textSelection(.enabled).frame(maxWidth: .infinity, alignment: .leading).padding()
+        if text.count > 65536 { Text("Preview shows the first 65,536 characters. Copy and Share/Save use the entire capture.").font(.footnote).padding() }
+      }.navigationTitle("Retained Terminal Text").navigationBarTitleDisplayMode(.inline)
+        .toolbar {
+          ToolbarItem(placement: .cancellationAction) { Button("Done", action: close) }
+          ToolbarItemGroup(placement: .bottomBar) {
+            Button("Copy") { UIPasteboard.general.string = text }
+            Spacer(); Button("Share / Save", action: share)
+          }
+        }
+    }.navigationViewStyle(.stack)
+  }
+}
+
+final class WorkbenchPresentation<Content: View>: UIHostingController<Content>, UIAdaptivePresentationControllerDelegate {
+  var onInteractiveDismiss: (() -> Void)?
+  func presentationControllerDidDismiss(_ presentationController: UIPresentationController) { onInteractiveDismiss?() }
+}
