+  var onCollapse: (() -> Void)?
+  var collapsed = true
+  private let row = UIStackView()
+  private let scroll = UIScrollView()
+  private let actions = UIStackView()
+  private var scrollHeight: NSLayoutConstraint!
+  init() {
+    super.init(effect: UIBlurEffect(style: .systemMaterial))
+    layer.cornerRadius = 18; clipsToBounds = true
+    accessibilityIdentifier = "terminal.customizationDock"
+    row.axis = .horizontal; row.alignment = .center; row.spacing = 4
+    row.translatesAutoresizingMaskIntoConstraints = false
+    contentView.addSubview(row)
+    scroll.translatesAutoresizingMaskIntoConstraints = false
+    scroll.showsHorizontalScrollIndicator = false
+    actions.axis = .horizontal; actions.spacing = 4; actions.translatesAutoresizingMaskIntoConstraints = false
+    scroll.addSubview(actions)
+    scrollHeight = scroll.heightAnchor.constraint(equalToConstant: 48)
+    NSLayoutConstraint.activate([scroll.widthAnchor.constraint(greaterThanOrEqualToConstant: 44), scrollHeight,
+      actions.leadingAnchor.constraint(equalTo: scroll.contentLayoutGuide.leadingAnchor), actions.trailingAnchor.constraint(equalTo: scroll.contentLayoutGuide.trailingAnchor),
+      actions.topAnchor.constraint(equalTo: scroll.contentLayoutGuide.topAnchor), actions.bottomAnchor.constraint(equalTo: scroll.contentLayoutGuide.bottomAnchor),
+      actions.heightAnchor.constraint(equalTo: scroll.frameLayoutGuide.heightAnchor)])
+    NSLayoutConstraint.activate([row.topAnchor.constraint(equalTo: contentView.topAnchor, constant: 4), row.bottomAnchor.constraint(equalTo: contentView.bottomAnchor, constant: -4), row.leadingAnchor.constraint(equalTo: contentView.leadingAnchor, constant: 4), row.trailingAnchor.constraint(equalTo: contentView.trailingAnchor, constant: -4)])
+  }
+  required init?(coder: NSCoder) { nil }
+  func rebuild(_ profile: WorkbenchProfile, color: UIColor, state: WorkbenchInteraction, pending: Int) {
+    for view in row.arrangedSubviews { row.removeArrangedSubview(view); view.removeFromSuperview() }
+    let size = CGFloat(profile.controlSize)
+    func button(_ title: String, _ symbol: String, _ action: @escaping () -> Void) -> UIButton {
+      let value = UIButton(type: .system)
+      value.setImage(UIImage(systemName: symbol), for: .normal); value.tintColor = color
+      value.accessibilityLabel = title
+      value.addAction(UIAction { _ in action() }, for: .touchUpInside)
+      value.widthAnchor.constraint(equalToConstant: size).isActive = true
+      value.heightAnchor.constraint(equalToConstant: size).isActive = true
+      return value
+    }
+    row.addArrangedSubview(button("Workspace", "square.grid.2x2") { [weak self] in self?.onAction?(.workspace) })
+    row.addArrangedSubview(button(state.keyboardLocked ? "Unlock and Show Keyboard" : "Show or Hide Keyboard", state.keyboardLocked ? "lock.open" : "keyboard") { [weak self] in self?.onAction?(.keyboard) })
+    if !collapsed {
+      for view in actions.arrangedSubviews { actions.removeArrangedSubview(view); view.removeFromSuperview() }
+      scrollHeight.constant = size
+      row.addArrangedSubview(scroll)
+      for action in profile.actions where action != .workspace && action != .keyboard {
+        let value = button(action.title, action.symbol) { [weak self] in self?.onAction?(action) }
+        if action == .keyboardLock { value.accessibilityValue = state.keyboardLocked ? "Locked" : "Unlocked" }
+        if action == .interaction { value.accessibilityValue = state.selecting ? "Select and Scroll" : "Input" }
+        if action == .cancelPaste { value.accessibilityValue = "\(pending) bytes pending" }
+        actions.addArrangedSubview(value)
+      }
+    }
+    row.addArrangedSubview(button(collapsed ? "Expand Controls" : "Collapse Controls", collapsed ? "chevron.left" : "chevron.right") { [weak self] in self?.onCollapse?() })
+  }
+}
