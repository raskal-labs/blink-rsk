+// GPL-3.0 + Blink additional terms. Uses existing SSH/SFTP and bookmark scopes.
+import Foundation
+import Combine
+import SSH
+import BlinkFiles
+import AppIntents
+import UniformTypeIdentifiers
+import UIKit
+
+@available(iOS 16.0, *)
+enum ShortcutsFiles {
+  @MainActor
+  static func connection(host: String, detail: String) async throws -> (String, SSHClientConfig) {
+    let space = try await SessionActionRunner.space()
+    _ = try await ShortcutPrompt().show(title: "SFTP on saved host?", message: host + "\n\n" + detail, in: space)
+    return try ShortcutsRunner.configuration(alias: host, space: space)
+  }
+  static func root(_ host: String, _ config: SSHClientConfig, path: String) -> AnyPublisher<Translator, Error> {
+    SSHClient.dial(host, with: config).flatMap { $0.requestSFTP() }
+      .tryMap { try SFTPTranslator(on: $0) }.flatMap { $0.walkTo(path) }.eraseToAnyPublisher()
+  }
+  @MainActor
+  static func listing(host: String, path: String) async throws -> String {
+    let path = try ShortcutPolicy.path(path)
+    let (hostname, config) = try await connection(host: host, detail: "List " + path)
+    return try await ShortcutsRunner.operation {
+      root(hostname, config, path: path).tryMap { translator -> SFTPTranslator in
+        guard let sftp = translator as? SFTPTranslator else { throw ShortcutFailure(message: "SFTP unavailable.") }
+        return sftp
+      }.flatMap { $0.directoryFilesAndAttributes(maxEntries: 2000) }
+        .tryMap { items -> String in
+          guard items.count <= 2000 else { throw ShortcutFailure(message: "Directory exceeds 2,000 entries. Choose a smaller directory.") }
+          let entries: [[String: Any]] = items.compactMap { attrs in
+            guard let name = attrs[.name] as? String, name != ".", name != ".." else { return nil }
+            return ["name": name, "type": (attrs[.type] as? FileAttributeType)?.rawValue ?? "unknown",
+                    "size": (attrs[.size] as? NSNumber)?.int64Value ?? 0]
+          }.sorted { ($0["name"] as! String) < ($1["name"] as! String) }
+          let data = try JSONSerialization.data(withJSONObject: ["host": host, "path": path, "entries": entries], options: [.sortedKeys])
+          guard data.count <= ShortcutPolicy.outputLimit else { throw ShortcutFailure(message: "Directory result exceeds 256 KiB. Choose a smaller directory.") }
+          return String(decoding: data, as: UTF8.self)
+        }.eraseToAnyPublisher()
+    }
+  }
+  @MainActor
+  static func download(host: String, path: String) async throws -> IntentFile {
+    let path = try ShortcutPolicy.path(path)
+    let name = try ShortcutPolicy.filename((path as NSString).lastPathComponent)
+    let (hostname, config) = try await connection(host: host, detail: "Download " + path + "\nLimit: 16 MiB. Shortcuts chooses where to save the returned file.")
+    let data: Data = try await ShortcutsRunner.operation {
+      root(hostname, config, path: path).flatMap { translator in
+        translator.stat().tryMap { attrs in
+          guard translator.fileType == .typeRegular,
+                let size = attrs[.size] as? NSNumber, size.int64Value >= 0,
+                size.int64Value <= ShortcutPolicy.fileLimit else {
+            throw ShortcutFailure(message: "Download requires a regular file no larger than 16 MiB.")
+          }
+          return translator
+        }.flatMap { $0.open(flags: O_RDONLY) }
+      }.flatMap { file in
+        // SFTPFile.read ignores its max argument. Enforce the bound on each block,
+        // including a file that grows after stat; never collect unbounded data.
+        file.read(max: ShortcutPolicy.fileLimit + 1).tryReduce(Data()) { data, block in
+          guard data.count + block.count <= ShortcutPolicy.fileLimit else {
+            throw ShortcutFailure(message: "Download grew beyond 16 MiB; no file was returned.")
+          }
+          var result = data; result.append(contentsOf: block); return result
+        }.flatMap { data in file.close().map { _ in data } }
+      }.eraseToAnyPublisher()
+    }
+    return IntentFile(data: data, filename: name)
+  }
+  // Read the provider-owned input under coordination and balance only the scope
+  // acquired by this action. No input deletion, bookmark mutation or local overwrite.
+  static func readInput(_ input: IntentFile) throws -> Data {
+    guard let url = input.fileURL else {
+      let data = input.data
+      guard data.count <= ShortcutPolicy.fileLimit else { throw ShortcutFailure(message: "Upload exceeds 16 MiB.") }
+      return data
+    }
+    let scoped = url.startAccessingSecurityScopedResource()
+    defer { if scoped { url.stopAccessingSecurityScopedResource() } }
+    var coordinationError: NSError?
+    var result: Result<Data, Error> = .failure(ShortcutFailure(message: "Input file is unavailable."))
+    NSFileCoordinator().coordinate(readingItemAt: url, options: [], error: &coordinationError) { readable in
+      result = Result {
+        let values = try readable.resourceValues(forKeys: [.isRegularFileKey, .fileSizeKey])
+        guard values.isRegularFile == true, let size = values.fileSize, size <= ShortcutPolicy.fileLimit else {
+          throw ShortcutFailure(message: "Upload requires a regular file no larger than 16 MiB.")
+        }
+        let handle = try FileHandle(forReadingFrom: readable)
+        defer { try? handle.close() }
+        let data = try handle.read(upToCount: ShortcutPolicy.fileLimit + 1) ?? Data()
+        guard data.count <= ShortcutPolicy.fileLimit else { throw ShortcutFailure(message: "Upload exceeds 16 MiB.") }
+        return data
+      }
+    }
+    if let coordinationError { throw coordinationError }
+    return try result.get()
+  }
+  @MainActor
+  static func upload(host: String, directory: String, filename: String?, input: IntentFile) async throws -> String {
+    let directory = try ShortcutPolicy.path(directory)
+    let name = try ShortcutPolicy.filename(filename.flatMap { $0.isEmpty ? nil : $0 } ?? input.filename)
+    let (hostname, config) = try await connection(host: host,
+      detail: "Upload " + name + " to " + directory + "\nExisting destinations are rejected. A cancelled or failed upload may leave a partial file; inspect it before retrying.")
+    return try await ShortcutsRunner.operation {
+      let data = try readInput(input)
+      let block = data.withUnsafeBytes { DispatchData(bytes: $0) }
+      return root(hostname, config, path: directory).tryMap { translator -> SFTPTranslator in
+        guard let sftp = translator as? SFTPTranslator else { throw ShortcutFailure(message: "SFTP destination is unavailable.") }
+        return sftp
+      }.flatMap { $0.createExclusive(name: name) }
+        .flatMap { file in
+          // Empty input is a valid zero-byte file; don't call the channel writer
+          // with an empty buffer. Explicit close is part of successful completion.
+          let writing: AnyPublisher<Int, Error> = data.isEmpty
+            ? Just(0).setFailureType(to: Error.self).eraseToAnyPublisher()
+            : file.write(block, max: block.count).reduce(0, +).eraseToAnyPublisher()
+          return writing.tryMap { count -> Int in
+            guard count == data.count else { throw ShortcutFailure(message: "Upload byte count did not match input.") }
+            return count
+          }.flatMap { count in file.close().map { _ in count } }
+        }.tryMap { count in
+          let result = try JSONSerialization.data(withJSONObject: ["host": host, "directory": directory,
+            "filename": name, "bytes": count, "status": "uploaded"], options: [.sortedKeys])
+          return String(decoding: result, as: UTF8.self)
+        }.eraseToAnyPublisher()
+    }
+  }
+}
