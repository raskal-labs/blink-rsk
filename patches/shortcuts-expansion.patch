+// Single-resolution bridge. Cancellation/deadline can resolve while libssh is in
+// a blocking SFTP call; resource cleanup is then performed on the owning run loop.
+final class ShortcutCompletion<Value>: @unchecked Sendable {
+  private let lock = NSLock()
+  private var result: Result<Value, Error>?
+  private var continuation: CheckedContinuation<Value, Error>?
+  var isFinished: Bool { lock.lock(); defer { lock.unlock() }; return result != nil }
+  func install(_ continuation: CheckedContinuation<Value, Error>) {
+    lock.lock()
+    if let result { lock.unlock(); continuation.resume(with: result) }
+    else { self.continuation = continuation; lock.unlock() }
+  }
+  func finish(_ result: Result<Value, Error>) {
+    lock.lock()
+    guard self.result == nil else { lock.unlock(); return }
+    self.result = result
+    let continuation = self.continuation
+    self.continuation = nil
+    lock.unlock()
+    continuation?.resume(with: result)
   }
 }
