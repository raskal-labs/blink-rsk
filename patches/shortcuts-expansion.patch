+// Bounds and wire format shared by the foreground SSH/SFTP intents.
+enum ShortcutPolicy {
+  static let outputLimit = 262144 // each of stdout/stderr; overflow fails explicitly
+  static let fileLimit = 16 * 1024 * 1024
+  static func path(_ value: String) throws -> String {
+    guard !value.isEmpty, value.utf8.count <= 4096,
+          value.rangeOfCharacter(from: .controlCharacters) == nil,
+          !value.contains("~") || value == "~" || value.hasPrefix("~/") else {
+      throw SessionLink.ValidationError.invalidCommand
+    }
+    // Resolve relative paths against the account's home, never a previous action.
+    return value.hasPrefix("/") || value.hasPrefix("~") ? value : "~/" + value
+  }
+  static func filename(_ value: String) throws -> String {
+    guard !value.isEmpty, value != ".", value != "..", value.utf8.count <= 255,
+          !value.contains("/"), !value.contains("\\"),
+          value.rangeOfCharacter(from: .controlCharacters) == nil else {
+      throw SessionLink.ValidationError.invalidCommand
+    }
+    return value
+  }
+  // Run in a child shell so exit/exec and trailing comments cannot skip the trailer.
+  // A fresh nonce and exact suffix avoid mistaking ordinary output for exit status.
+  static func wrapped(_ command: String, nonce: String) -> String {
+    "sh -c " + SessionLink.shellQuote(command) + #"; printf '\n"# + nonce + #":%d\n' "$?""#
+  }
+  static func parse(_ data: Data, nonce: String) throws -> (String, Int32) {
+    let text = String(decoding: data, as: UTF8.self)
+    guard text.hasSuffix("\n"), let range = text.range(of: "\n" + nonce + ":", options: .backwards),
+          let code = Int32(text[range.upperBound...].dropLast()), (0...255).contains(code) else {
+      throw SessionLink.ValidationError.invalidCommand
+    }
+    return (String(text[..<range.lowerBound]), code)
+  }
+}
