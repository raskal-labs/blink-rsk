+// Selective adaptation of blinksh/blink@7a427f3 Blink/Fleet/HeadlessSSHRunner.swift.
+// GPL-3.0 + Blink additional terms. Foreground only; no Fleet service or trust bypass.
+import Foundation
+import Combine
+import SSH
+import BlinkConfig
+import UIKit
+
+struct ShortcutFailure: Error, LocalizedError {
+  let message: String
+  var errorDescription: String? { message }
+}
+
+@MainActor
+final class ShortcutPrompt {
+  private var alert: UIAlertController?
+  private var continuation: CheckedContinuation<[String], Error>?
+  private var cancelled = false
+  func cancel() {
+    cancelled = true
+    finish(.failure(CancellationError()))
+  }
+  private func finish(_ result: Result<[String], Error>) {
+    guard let continuation else { return }
+    self.continuation = nil
+    alert?.dismiss(animated: true)
+    alert = nil
+    continuation.resume(with: result)
+  }
+  func show(title: String, message: String, questions: [String] = [], secure: Bool = true,
+            in space: SpaceController) async throws -> [String] {
+    try await withTaskCancellationHandler(operation: {
+      try Task.checkCancellation()
+      if cancelled { throw CancellationError() }
+      return try await withCheckedThrowingContinuation { continuation in
+        guard space.presentedViewController == nil, !space.isSnipsInputModeActive else {
+          continuation.resume(throwing: SessionActionError.busy); return
+        }
+        self.continuation = continuation
+        let alert = UIAlertController(title: title, message: message, preferredStyle: .alert)
+        self.alert = alert
+        for question in questions {
+          alert.addTextField { field in field.placeholder = question; field.isSecureTextEntry = secure }
+        }
+        alert.addAction(UIAlertAction(title: "Cancel", style: .cancel) { _ in
+          self.finish(.failure(CancellationError()))
+        })
+        alert.addAction(UIAlertAction(title: questions.isEmpty ? "Continue" : "Authenticate", style: .default) { _ in
+          self.finish(.success(alert.textFields?.map { $0.text ?? "" } ?? []))
+        })
+        space.present(alert, animated: true)
+      }
+    }, onCancel: { Task { @MainActor in self.cancel() } })
+  }
+}
+
+@available(iOS 16.0, *)
+enum ShortcutsRunner {
+  // Runs configuration/auth prompts on the foreground app, with saved host/default
+  // signers, linked default agent, stored password and interactive challenges.
+  // Unknown/changed host keys fail closed. Establish trust interactively in Blink.
+  @MainActor
+  static func configuration(alias: String, space: SpaceController) throws -> (String, SSHClientConfig) {
+    try SessionLink.validateHost(alias)
+    guard BKHosts.withHost(alias) != nil else { throw SessionActionError.unknownHost }
+    let bk = try BKConfig()
+    let host = try bk.bkSSHHost(alias)
+    let logger = PassthroughSubject<String, Never>()
+    let agent = SSHAgent()
+    let constraints: [SSHAgentConstraint] = [SSHConstraintTrustedConnectionOnly()]
+    let signers = bk.signer(forHost: host) ?? bk.defaultSigners()
+    for (signer, name) in signers {
+      if let prompter = signer as? BlinkConfig.InputPrompter, let view = space.currentDevice?.view {
+        prompter.setPromptOnView(view)
+        prompter.setLogger(logger, verbosity: .none)
+      }
+      agent.loadKey(signer, aka: name, constraints: constraints)
+    }
+    if let linked = SSHDefaultAgent.instance { agent.linkTo(agent: linked) }
+    let answer: AuthKeyboardInteractive.RequestAnswersCb = { prompt in
+      Deferred {
+        var task: Task<Void, Never>?
+        return Future<[String], Error> { promise in
+          task = Task { @MainActor in
+            do {
+              let values = try await ShortcutPrompt().show(title: "Authenticate to " + alias,
+                message: prompt.instruction, questions: prompt.userPrompts.map { $0.prompt }, in: space)
+              promise(.success(values))
+            } catch { promise(.failure(error)) }
+          }
+        }.handleEvents(receiveCancel: { task?.cancel() })
+      }.eraseToAnyPublisher()
+    }
+    var auth: [AuthMethod] = [AuthAgent(agent)]
+    if let password = host.password, !password.isEmpty { auth.append(AuthPassword(with: password)) }
+    auth.append(AuthKeyboardInteractive(requestAnswers: answer, wrongRetriesAllowed: 1))
+    auth.append(AuthPasswordInteractive(requestAnswers: answer, wrongRetriesAllowed: 1))
+    let verify: SSHClientConfig.RequestVerifyHostCallback = { _ in
+      Fail(error: ShortcutFailure(message: "Host key is unknown or changed. Verify this host in Blink's terminal first."))
+        .eraseToAnyPublisher()
+    }
+    return (host.hostName ?? alias, host.sshClientConfig(authMethods: auth,
+      verifyHostCallback: verify, agent: agent, logger: logger))
+  }
+
+  // Same dedicated run-loop requirement as upstream. Combine cancellation and
+  // completion cleanup occur on that thread, including when cancelled before dial.
+  static func operation<T>(timeout: TimeInterval = 60,
+                           make: @escaping () throws -> AnyPublisher<T, Error>) async throws -> T {
+    let completion = ShortcutCompletion<T>()
+    return try await withTaskCancellationHandler(operation: {
+      try Task.checkCancellation()
+      return try await withCheckedThrowingContinuation { continuation in
+        completion.install(continuation)
+        let deadline = DispatchWorkItem {
+          completion.finish(.failure(ShortcutFailure(message: "Action timed out after \(Int(timeout)) seconds. A remote command or partial upload may remain; inspect before retrying.")))
+        }
+        DispatchQueue.global().asyncAfter(deadline: .now() + timeout, execute: deadline)
+        let worker = Thread {
+          var subscription: AnyCancellable?
+          let loop = CFRunLoopGetCurrent()
+          func stopIfFinished() {
+            if completion.isFinished {
+              subscription?.cancel()
+              subscription = nil
+              CFRunLoopStop(loop)
+              CFRunLoopWakeUp(loop)
+            }
+          }
+          let timer = Timer(timeInterval: 0.05, repeats: true) { _ in stopIfFinished() }
+          RunLoop.current.add(timer, forMode: .default)
+          if !completion.isFinished {
+            do {
+              subscription = try make().sink(receiveCompletion: { result in
+                if case .failure(let error) = result { completion.finish(.failure(error)) }
+                else { completion.finish(.failure(ShortcutFailure(message: "Connection closed without a result."))) }
+                stopIfFinished()
+              }, receiveValue: { value in
+                completion.finish(.success(value))
+                stopIfFinished()
+              })
+            } catch { completion.finish(.failure(error)) }
+          }
+          if !completion.isFinished { CFRunLoopRun() }
+          timer.invalidate()
+          subscription?.cancel()
+          deadline.cancel()
+        }
+        worker.name = "blink.shortcuts.ssh"
+        worker.stackSize = 2 << 20
+        worker.start()
+      }
+    }, onCancel: { completion.finish(.failure(CancellationError())) })
+  }
+
+  @MainActor
+  static func run(host: String, command: String, preview: String) async throws -> String {
+    let space = try await SessionActionRunner.space()
+    _ = try await ShortcutPrompt().show(title: "Run on saved host?", message: host + "\n\n" + preview, in: space)
+    let (hostname, config) = try configuration(alias: host, space: space)
+    let nonce = "BLINK_" + UUID().uuidString.replacingOccurrences(of: "-", with: "")
+    let result: (Data, Data) = try await operation {
+      SSHClient.dial(hostname, with: config)
+        .flatMap { $0.requestExec(command: ShortcutPolicy.wrapped(command, nonce: nonce)) }
+        .flatMap { stream in stream.sendEOF().map { stream } }
+        .flatMap { stream in
+          // Bound the *reads*, not just the final strings. Zip is valid here:
+          // Stream.read reduces one bounded read to exactly one value per channel.
+          Publishers.Zip(stream.read(max: ShortcutPolicy.outputLimit + 1),
+                         stream.read_err(max: ShortcutPolicy.outputLimit + 1))
+        }.eraseToAnyPublisher()
+        .tryMap { out, err in
+          guard out.count <= ShortcutPolicy.outputLimit, err.count <= ShortcutPolicy.outputLimit else {
+            throw ShortcutFailure(message: "Output exceeded 256 KiB per channel. Redirect large output to a remote file and download it. The remote process may still be running.")
+          }
+          return (Data(out), Data(err))
+        }.eraseToAnyPublisher()
+    }
+    let parsed: (String, Int32)
+    do { parsed = try ShortcutPolicy.parse(result.0, nonce: nonce) }
+    catch { throw ShortcutFailure(message: "Remote exit status was not received. Success cannot be established.") }
+    let stderr = String(decoding: result.1, as: UTF8.self)
+    guard parsed.1 == 0 else {
+      throw ShortcutFailure(message: "Remote command exited \(parsed.1). " + String((stderr.isEmpty ? parsed.0 : stderr).prefix(4096)))
+    }
+    let data = try JSONSerialization.data(withJSONObject: ["host": host, "stdout": parsed.0,
+      "stderr": stderr, "exitCode": parsed.1], options: [.sortedKeys])
+    return String(decoding: data, as: UTF8.self)
+  }
+}
